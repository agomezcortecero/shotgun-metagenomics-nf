check_max = { obj, type ->
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    }
}

process {
    // Aquí continúa tu configuración habitual de base.config
    cpus   = { check_max( 1 * task.attempt, 'cpus' ) }
    memory = { check_max( 6.GB * task.attempt, 'memory' ) }
    time   = { check_max( 4.h * task.attempt, 'time' ) }
}

params {
    input                      = "data/*_R{1,2}.fastq.gz"
    outdir                     = "results"
    motus_db                   = "s3://ngs-databases/motus/db_v3"
    eggnog_db                  = "s3://ngs-databases/eggnog/v5.0"
    
    // Process resources
    max_memory                 = '128.GB'
    max_cpus                   = 32
    max_time                   = '24.h'
}

includeConfig 'conf/base.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'workq'
    }
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = 'metagenomics-batch-queue'
        aws.region             = 'eu-west-1'
        aws.batch.cliPath      = '/usr/local/bin/aws'
        docker.enabled         = true
        workDir                = 's3://your-metagenomics-bucket/nextflow-work'
    }
}
