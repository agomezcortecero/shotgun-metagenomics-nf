// 1. Función check_max definida al inicio del archivo como clausura Groovy
check_max = { obj, type ->
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            return obj
        }
    }
}

// 2. Parámetros globales del pipeline
params {
    // Input/Output parameters
    reads                      = "data/*_{1,2}.fastq.gz"
    outdir                     = "results"
    
    // Process parameters
    adapter_fasta              = null
    eggnog_db                  = "/data/eggnog-mapper-data"
    
    // Limits
    max_memory                 = '32.GB'
    max_cpus                   = 16
    max_time                   = '24.h'
}

// 3. Configuración de procesos
process {
    cpus   = { check_max( 4 * task.attempt, 'cpus' ) }
    memory = { check_max( 8.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h * task.attempt, 'time' ) }
    
    // Container images (Biocontainers)
    withName: FASTP {
        container = 'quay.io/biocontainers/fastp:0.23.4--h87f3051_1'
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: MOTUS_PROFILE {
        container = 'quay.io/biocontainers/motus:3.1.0--pyhdfd78af_0'
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: MEGAHIT {
        container = 'quay.io/biocontainers/megahit:1.2.9--h2e03b76_1'
        cpus   = { check_max( 16 * task.attempt, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    }
    withName: EGGNOG_MAPPER {
        container = 'quay.io/biocontainers/eggnog-mapper:2.1.12--pyhdfd78af_0'
        cpus   = { check_max( 16 * task.attempt, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
    }
    withName: COVERM {
        container = 'quay.io/biocontainers/coverm:0.6.1--h07ea13f_1'
        cpus   = { check_max( 16 * task.attempt, 'cpus' ) }
        memory = { check_max( 16.GB * task.attempt, 'memory' ) }
    }
    withName: MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.19--pyhdfd78af_0'
        cpus   = { check_max( 2 * task.attempt, 'cpus' ) }
        memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    }
}

// 4. Perfiles de ejecución
profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    awsbatch {
        process.executor       = 'awsbatch'
        process.queue          = 'nextflow-batch-queue'
        aws.region             = 'eu-west-1'
    }
    slurm {
        process.executor       = 'slurm'
        process.queue          = 'medium'
    }
}